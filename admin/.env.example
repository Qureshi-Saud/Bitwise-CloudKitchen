# Only wiring lives here. The store name, logo and every other business value
# are managed inside the panel itself, under Organization.
#
# Every value below is OPTIONAL. With none of them set, the app resolves the API
# from the page itself: in dev that is the current hostname on VITE_API_PORT, in
# a build it is the origin the app was served from (same-domain / reverse proxy).
# Set these only when the API lives somewhere else.

# Full REST base — overrides everything below.
# VITE_API_URL=https://api.example.com/api/v1

# API host when the API is on another domain but the prefix is the default.
# VITE_SERVER_URL=https://api.example.com

# Socket.IO endpoint, if it differs from the API host.
# VITE_SOCKET_URL=https://api.example.com

# Dev-only: the port the API listens on (matches PORT in server/.env).
# VITE_API_PORT=5000

# REST path prefix (matches API_PREFIX in server/.env).
# VITE_API_PREFIX=/api/v1

# Public storefront URL — used for "view on site" style links out of the panel.
# Matches CLIENT_URL in server/.env. Defaults to http://localhost:5173 in dev.
# VITE_CLIENT_URL=https://shop.example.com
